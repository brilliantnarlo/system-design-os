        <mxCell id="note2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B55;fontStyle=0;" value="GPIO has pull-ups. The manager detects rising edges, so switches that close to ground need polarity normalization for press-to-move." vertex="1">
