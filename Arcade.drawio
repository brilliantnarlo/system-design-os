  <diagram name="Page-1" id="DDsgaEpw27WiYW2LREfU">
    <mxGraphModel dx="2028" dy="673" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="6IjeFF7X5D7AmlJ2Y9h3-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=30;" value="Hardware Engineering - Aracade System Design" vertex="1">
          <mxGeometry height="30" width="660" x="110" y="50" as="geometry" />
        </mxCell>
        <mxCell id="6IjeFF7X5D7AmlJ2Y9h3-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;/h1&gt;&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Project Description:&lt;/font&gt;&lt;/h3&gt;&lt;h4 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;This project consists of an FPGA-based arcade gaming system designed and implemented using Verilog HDL. The system features ten classic arcade games accessible through a simple, interactive game selection menu.&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Players can navigate the menu using directional buttons or a joystick, select a game, play it, and return to the main menu.&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;The system implements game logic, graphics rendering, player input processing, collision detection, score management, and sound generation directly in digital hardware, without requiring a general-purpose processor or operating system.&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/h4&gt;&lt;h4 style=&quot;margin-top: 0px;&quot;&gt;&lt;/h4&gt;&lt;h3&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Helvetica&quot;&gt;Project Features:&lt;/font&gt;&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Interactive arcade game selection menu.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Ten classic arcade games.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;VGA or HDMI display output.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Joystick and button controls.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Hardware-based graphics rendering.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Bitmap font and sprite rendering.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Collision detection.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Score and high-score management.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Sound effects.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Modular and reusable Verilog architecture.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;font style=&quot;&quot; face=&quot;Helvetica&quot;&gt;&lt;h4 style=&quot;font-weight: normal; font-size: 12px; margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/h4&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Arcade Games:&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Pong&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Breakout&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Snake&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Tic-Tac-Toe&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Racing&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Flappy Bird&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Tetris&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Space Invaders&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Pac-Man&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Platformer&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;font style=&quot;&quot; face=&quot;Helvetica&quot;&gt;&lt;h4 style=&quot;font-size: 12px; font-weight: normal; margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/h4&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Device Specifications&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Parameter&lt;/font&gt;&lt;/th&gt;&lt;th&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Specification&lt;/font&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Development Board&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Sipeed Tang Primer 20K&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Manufacturer&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Gowin Semiconductor&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Part Number&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;GW2A-LV18PG256C8/I7&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Series&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;GW2A&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Device&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;GW2A-18C&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Package&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;PBGA256&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Speed Grade&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;C8/I7&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Hardware Description Language&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Verilog HDL&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Development Environment&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 12px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Gowin EDA&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;h4 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/h4&gt;&lt;h4 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;&quot; face=&quot;Helvetica&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Project Objective:&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-weight: normal; font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;The objective of this project is to explore digital hardware programming by developing a fully functional arcade gaming console from scratch. It demonstrates the practical application of registers, counters, multiplexers, finite state machines, memory architecture, video signal generation, and digital signal processing in an FPGA-based system.&lt;/font&gt;&lt;/h4&gt;" vertex="1">
